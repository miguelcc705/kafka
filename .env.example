# Copia este archivo a .env y ajusta los valores. docker compose lo lee automáticamente.
# Todos los valores tienen un default, así que .env es opcional.

# --- Puertos publicados en el host ---
KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8090
TRANSFER_DB_HOST_PORT=5432
FRAUD_DB_HOST_PORT=5433
TRANSFER_SERVICE_HOST_PORT=8080
FRAUD_SERVICE_HOST_PORT=8081

# --- Base de datos de transfer-service ---
TRANSFER_DB_USER=transfer
TRANSFER_DB_PASSWORD=transfer

# --- Base de datos de fraud-service ---
FRAUD_DB_USER=fraud
FRAUD_DB_PASSWORD=fraud

# --- Reglas de fraude (fraud.rules.*) ---
FRAUD_RULES_AMOUNT_THRESHOLD=10000000
FRAUD_RULES_VELOCITY_MAX_TRANSFERS=3
FRAUD_RULES_VELOCITY_WINDOW=60s

# --- Solo perfil local (servicios corriendo en el IDE): exportarlas en el entorno del IDE ---
# Si cambias los puertos del host, ajusta estas URLs.
# TRANSFER_DB_URL=jdbc:postgresql://localhost:5432/transfers
# FRAUD_DB_URL=jdbc:postgresql://localhost:5433/fraud
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
